# Copy to `anynanny-web/.env.local` and fill in values (never commit `.env.local`).

# --- Supabase (existing) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: required for Stripe webhooks to update `bookings` (bypasses RLS). Keep server-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs (Stripe redirects) ---
# Production: https://your-domain.com  | Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used if you add Stripe.js / Elements later (Checkout redirect does not require it on the client).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
